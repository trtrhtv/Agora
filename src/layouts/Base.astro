---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        max-width: 48rem;
        margin: 0 auto;
        padding: 1rem;
        line-height: 1.6;
      }
      [lang='en'] {
        direction: ltr;
        unicode-bidi: isolate;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
