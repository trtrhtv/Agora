---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'אגורה' ? title : `${title} · אגורה`}</title>
    <style is:global>
      :root {
        --bg: #fbfaf7;
        --fg: #1f1d1a;
        --muted: #6b665e;
        --line: #e3dfd6;
        --accent: #8a4b16;
        --quote-bg: #f2eee6;
        --assess-bg: #eef2f7;
        --assess-line: #5b7aa6;
        --warn-bg: #fbf1e6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #171614;
          --fg: #ece8e1;
          --muted: #a29c92;
          --line: #34312c;
          --accent: #e0a46b;
          --quote-bg: #23211e;
          --assess-bg: #1d2430;
          --assess-line: #7f9cc7;
          --warn-bg: #2a2219;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, 'Segoe UI', Arial, sans-serif;
        max-width: 46rem;
        margin: 0 auto;
        padding: 0 1rem 4rem;
        line-height: 1.75;
        font-size: 1.05rem;
        overflow-wrap: anywhere;
      }
      a {
        color: var(--accent);
      }
      header.site {
        display: flex;
        gap: 1rem;
        align-items: baseline;
        border-bottom: 1px solid var(--line);
        padding: 0.75rem 0;
        margin-bottom: 1rem;
      }
      header.site a.home {
        font-weight: 700;
        text-decoration: none;
        font-size: 1.2rem;
      }
      h1 {
        line-height: 1.3;
        margin-bottom: 0.25rem;
      }
      h2 {
        margin-top: 2.2rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.2rem;
      }
      .muted {
        color: var(--muted);
      }
      [lang='en'] {
        direction: ltr;
        unicode-bidi: isolate;
      }
      .badge {
        display: inline-block;
        font-size: 0.9rem;
        padding: 0.15rem 0.6rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        margin-inline-end: 0.4rem;
      }
      sup.cite {
        font-size: 0.7em;
        margin-inline-start: 0.1em;
      }
      sup.cite a {
        text-decoration: none;
      }
      aside.assessment {
        background: var(--assess-bg);
        border-inline-start: 4px solid var(--assess-line);
        padding: 0.6rem 1rem;
        margin: 1.2rem 0;
        border-radius: 4px;
      }
      aside.assessment p {
        margin: 0.3rem 0 0;
      }
      .assessment-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--assess-line);
      }
      figure.quote {
        background: var(--quote-bg);
        margin: 1rem 0;
        padding: 0.8rem 1rem;
        border-radius: 4px;
      }
      figure.quote blockquote {
        margin: 0;
        font-family: Georgia, 'Times New Roman', serif;
      }
      figure.quote figcaption {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.4rem;
      }
      details.check {
        background: var(--warn-bg);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        margin: 1rem 0;
      }
      details.check summary {
        cursor: pointer;
        font-weight: 600;
      }
      ol.sources li {
        margin-bottom: 0.4rem;
      }
      ol.sources li:target {
        background: var(--warn-bg);
      }
      ul.links {
        padding-inline-start: 1.2rem;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        display: block;
        overflow-x: auto;
      }
      td,
      th {
        border: 1px solid var(--line);
        padding: 0.3rem 0.5rem;
        text-align: start;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="home" href="/">אגורה</a>
      <span class="muted">ספרייה אישית של רעיונות</span>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
